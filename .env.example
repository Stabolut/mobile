# ==========================================================
# STABOLUT MOBILE CONFIGURATION (.env.example)
# ==========================================================

# Backend API endpoint (points to your local or deployed Stabolut backend)
API_URL=http://localhost:8003/api/v1/stabolut

# Backend WebSocket endpoint for real-time transactions
SOCKET_URL=http://localhost:8003

# Blockchain RPC (Default: Arbitrum Sepolia public RPC)
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# USB Token Contract Address
CONTRACT_ADDRESS=0x24c8479b8af9742c5160e0c29197e87a584cfe99

# Block Explorer URL
EXPLORER_URL=https://sepolia.arbiscan.io/tx/
